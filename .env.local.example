# Supabase — obtido em Settings > API no dashboard do projeto
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key

# Supabase service role — nunca expor no cliente
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

# URL da aplicação (sem barra final)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Mercado Pago — obtido em mercadopago.com.br > Seu negócio > Credenciais
# Em produção: usar credenciais reais da conta do Henrique
MERCADOPAGO_ACCESS_TOKEN=TEST-seu-access-token
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=TEST-sua-public-key