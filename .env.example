# Ao copiar um valor para a Vercel, copie SÓ o valor: o dotenv corta o comentário
# inline, o campo da Vercel não corta e o comentário vira parte do valor.

# URL da aplicação (sem barra final)
# Produção: https://patriciacarreira.com.br
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase — obtido em Settings > API no dashboard do projeto
NEXT_PUBLIC_SUPABASE_URL=YOUR_SUPABASE_URL
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# Supabase service role — nunca expor no cliente
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_ACCESS_TOKEN=YOUR_SUPABASE_ACCESS_TOKEN

# Mercado Pago — obtido em mercadopago.com.br > Seu negócio > Credenciais
MERCADOPAGO_ACCESS_TOKEN=YOUR_MERCADOPAGO_ACCESS_TOKEN
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=YOUR_MERCADOPAGO_PUBLIC_KEY
MERCADOPAGO_WEBHOOK_SECRET=YOUR_MERCADOPAGO_WEBHOOK_SECRET

# Melhor Envio — obtido em melhorenvio.com.br
MELHOR_ENVIO_TOKEN=YOUR_MELHOR_ENVIO_TOKEN
MELHOR_ENVIO_BASE_URL=https://www.melhorenvio.com.br/api/v2
MELHOR_ENVIO_APP_NAME=PatriciaCarreira
MELHOR_ENVIO_CONTACT_EMAIL=contato@patriciacarreira.com.br
MELHOR_ENVIO_WEBHOOK_SECRET=YOUR_MELHOR_ENVIO_WEBHOOK_SECRET

# Identidade e endereços da loja — MIGRADOS PARA O BANCO
#
# Endereço fiscal (o que sai na nota) e endereço de origem do frete (de onde o
# pacote sai) eram estas mesmas variáveis, e deixaram de coincidir. Hoje os dois
# são campos de store_settings, editados em /admin/config/fiscal e
# /admin/config/envio. As variáveis abaixo continuam sendo lidas SÓ como rede de
# segurança, enquanto o endereço de origem no painel não estiver completo — e
# nenhuma delas alimenta mais a NF-e. Podem ser removidas depois que
# /admin/diagnostico mostrar "Fonte do endereço: painel".
STORE_NOME=Patricia Carreira
STORE_EMAIL=contato@patriciacarreira.com.br
STORE_TELEFONE=73999999999
# CNPJ sem pontuação (remetente no Melhor Envio)
STORE_DOCUMENTO=00000000000000
STORE_LOGRADOURO=Rua das Flores
STORE_NUMERO=123
STORE_COMPLEMENTO=
STORE_BAIRRO=Arraial D'Ajuda
STORE_CIDADE=Porto Seguro
STORE_ESTADO=BA
# CEP da loja em Arraial D'Ajuda
STORE_CEP_ORIGEM=45816000

# Focus NFe — obtido em app.focusnfe.com.br
FOCUS_NFE_TOKEN=YOUR_FOCUS_NFE_TOKEN
# segredo para validar callbacks
FOCUS_NFE_WEBHOOK_SECRET=YOUR_FOCUS_NFE_WEBHOOK_SECRET
# 'homologacao' ou 'producao' — trocar só no lançamento
FOCUS_NFE_AMBIENTE=homologacao
# Regime tributário migrou para /admin/config/fiscal — esta variável não é mais lida

# Dados fiscais do emitente (NF-e) — MIGRADOS PARA O BANCO
#
# CNPJ, razão social, Inscrição Estadual, CNAE e endereço fiscal agora são campos
# de store_settings, preenchidos em /admin/config/fiscal com o cartão CNPJ. Estas
# variáveis não são mais lidas na emissão: STORE_CNPJ e STORE_IE sobram apenas
# como referência histórica e podem ser removidas da Vercel.
STORE_CNPJ=
STORE_IE=
STORE_CNAE=

# Resend — obtido em resend.com
# Domínio verificado: creation@patriciacarreira.com.br
RESEND_API_KEY=YOUR_RESEND_API_KEY
RESEND_FROM=creation@patriciacarreira.com.br
